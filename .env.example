# Forge Environment Configuration
# Copy this to .env and fill in your values

# === Cloud Provider: NVIDIA NIM ===
# Get your API key at: https://build.nvidia.com
NVIDIA_API_KEY=

# === Cloud Provider: Google Gemini ===
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Cloud Provider: OpenRouter ===
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# === Local Provider: Ollama ===
# Default: http://localhost:11434
# Make sure Ollama is running: `ollama serve`
# Pull a model: `ollama pull qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://localhost:11434

# === Model Overrides (optional) ===
# Override the default model for specific pipeline stages
# FORGE_MODEL_INTAKE=gemini-2.5-flash
# FORGE_MODEL_ARCHITECT=gemini-2.5-flash
# FORGE_MODEL_DESIGN_BRAIN=gemini-2.5-flash
# FORGE_MODEL_MOTION_BRAIN=gemini-2.5-flash
# FORGE_MODEL_CODEGEN=gemini-2.5-flash
# FORGE_MODEL_CRITIC=gemini-2.5-flash

# === Output ===
# Directory for generated projects (default: ./generated)
# FORGE_OUTPUT_DIR=./generated
